<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TideTool" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/teal</item>
        <item name="colorOnPrimary">@color/ink_on_teal</item>
        <item name="colorPrimaryContainer">@color/teal_dim</item>
        <item name="colorOnPrimaryContainer">@color/teal</item>
        <item name="colorSecondary">@color/sand</item>
        <item name="colorOnSecondary">@color/ink_on_sand</item>
        <item name="colorTertiary">@color/coral</item>
        <item name="colorError">@color/coral</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface2</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink2</item>
        <item name="colorOutline">@color/line</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.TideTool.Prompt" parent="Theme.TideTool">
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>
</resources>
